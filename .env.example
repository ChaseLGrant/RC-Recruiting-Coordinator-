# Local SQLite database file (default). Leave DATABASE_URL unset to use it.
RC_SQLITE_PATH=./data/rc.db

# Production: Postgres / Supabase connection string (server-side only).
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Protects /api/cron so only your scheduler can trigger mission runs.
CRON_SECRET=change-me

# Optional AI provider (used only to help parse free-text searches; never to grade athletes).
# ANTHROPIC_API_KEY=
# RC_AI_MODEL=claude-sonnet-5-5

# Optional email sending (Resend). Without it, approved messages are "ready to send" and
# coaches send them from their own email client.
# RESEND_API_KEY=
# RC_EMAIL_FROM=recruiting@yourschool.edu

# Licensed data providers. RC never scrapes. These connect only with a signed data agreement.
# MAXPREPS_API_KEY=
# MAXPREPS_API_BASE=
# PERFECT_GAME_API_KEY=
# PERFECT_GAME_API_BASE=
# PBR_API_KEY=
# PBR_API_BASE=

# RC owners (comma-separated emails) — can open /admin to turn paid add-ons on per school.
# RC_ADMIN_EMAILS=you@yourcompany.com

# Billing (Stripe). Billing is only enforced once these are set; until then everything is open.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...      (Stripe → Developers → Webhooks → endpoint https://YOUR-SITE/api/stripe/webhook)
# STRIPE_PRICE_MONTHLY=price_...       (create a recurring Product + Prices in Stripe)
# STRIPE_PRICE_YEARLY=price_...
# RC_TRIAL_DAYS=90
# RC_TRIAL_REQUIRES_CARD=false   # true = card required to start the trial
# RC_GUEST_DEMO_DAYS=14
# RC_GUEST_DEMOS_PER_HOUR=60
# RC_PREVIEWS_PER_SCHOOL_PER_DAY=25
# RC_PHOTO_IMPORTS_PER_DAY=40
# RC_PUBLIC_URL=https://YOUR-SITE

# AI research agent (included in every subscription, monthly check limit per school)
# ANTHROPIC_API_KEY=
# RC_AI_TRIAL_MONTHLY=200
# RC_AGENT_MODEL=claude-opus-5-5

# Player page finder (pick one)
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=
# BRAVE_SEARCH_API_KEY=
